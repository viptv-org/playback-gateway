<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.playbackgateway.runtime.qualification">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Torrent runtime qualification" android:debuggable="true"
        android:allowBackup="false" android:extractNativeLibs="true">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ProbeService" android:exported="false"
            android:process=":torrent_runtime" />
    </application>
</manifest>

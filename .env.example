# Generate a unique value; never commit a real key. Minimum 32 characters.
API_KEY=
MAX_OUTPUTS=8
# Optional render nodes; the operator must also map the device into the container:
# QSV_DEVICE=/dev/dri/renderD128
# VAAPI_DEVICE=/dev/dri/renderD128

# Optional New Relic OTLP monitoring; ingest-only key, never a user API key.
OBSERVABILITY_ENABLED=false
NEW_RELIC_REGION=US
NEW_RELIC_LICENSE_KEY=
OBSERVABILITY_DAILY_BYTES=10485760
OBSERVABILITY_TRACE_SAMPLE_RATE=0.1
OBSERVABILITY_EXPORT_INTERVAL_SECONDS=30
